---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Labs | Wretzelectronics">
  <section class="lab-header">
    <h1 class="page-title">Labs</h1>
    <p class="page-subtitle">
      Small engineering experiments, rapid prototypes, teardowns, and technical side-quests.
    </p>
  </section>

  <div class="lab-grid">
    <!-- Power Bank Salvage -->
    <a href="/lab/powerbank" class="lab-card cyber-card">
      <div class="card-image-wrapper">
        <img
          src="/images/labs/lab-powerbank.png"
          alt="Power bank salvage teardown"
          class="card-img"
          loading="lazy"
        />
      </div>
      <div class="card-body">
        <div class="tag-row">
          <span class="tag-badge">Teardown</span>
          <span class="tag-badge">Hardware</span>
        </div>
        <h2 class="card-title">Power Bank MOSFET Salvage</h2>
        <p class="card-desc">
          A teardown experiment exploring the protection, charging, and boost circuitry of a commercial power bank.
        </p>
        <span class="view-link">Read Log <span class="arrow">→</span></span>
      </div>
    </a>

    <!-- One-Hour Game -->
    <a href="/lab/game" class="lab-card cyber-card">
      <div class="card-image-wrapper">
        <span class="interactive-badge">
          <span class="pulse-dot"></span> Interactive Demo
        </span>
        <img
          src="/images/labs/lab-game.png"
          alt="One-hour game experiment"
          class="card-img"
          loading="lazy"
        />
      </div>
      <div class="card-body">
        <div class="tag-row">
          <span class="tag-badge">Rapid Build</span>
          <span class="tag-badge">JavaScript</span>
        </div>
        <h2 class="card-title">One-Hour Game Experiment</h2>
        <p class="card-desc">
          A rapid 60-minute prototyping challenge: building a Breakout clone with a neon cyber-slime aesthetic.
        </p>
        <div class="card-footer">
          <span class="view-link">Read Log & Play <span class="arrow">→</span></span>
        </div>
      </div>
    </a>

    <!-- Background Generation Lab -->
    <a href="/lab/backgrounds" class="lab-card cyber-card">
      <div class="card-image-wrapper">
        <span class="interactive-badge">
          <span class="pulse-dot"></span> Interactive Demo
        </span>
        <img
          src="/images/labs/lab-backgrounds.png"
          alt="Procedural background generation"
          class="card-img"
          loading="lazy"
        />
      </div>
      <div class="card-body">
        <div class="tag-row">
          <span class="tag-badge">Graphics</span>
          <span class="tag-badge">Procedural</span>
          <span class="tag-badge">JavaScript</span>
        </div>
        <h2 class="card-title">Procedural Background Experiments</h2>
        <p class="card-desc">
          A set of coded visual backgrounds including cosmic ribbons and jellyfish‑inspired motion fields.
        </p>
        <div class="card-footer">
          <span class="view-link">Read Log & Launch <span class="arrow">→</span></span>
        </div>
      </div>
    </a>
    <!-- Wheel Lab -->
    <a href="/lab/wheel" class="lab-card cyber-card">
      <div class="card-image-wrapper">
        <span class="interactive-badge">
          <span class="pulse-dot"></span> Interactive Demo
        </span>
        <img
          src="/images/labs/wheel.png"
          alt="Wheel randomizer tool"
          class="card-img"
          loading="lazy"
        />
      </div>

      <div class="card-body">
        <div class="tag-row">
          <span class="tag-badge">Tool</span>
          <span class="tag-badge">JavaScript</span>
          <span class="tag-badge">UI/UX</span>
        </div>

        <h2 class="card-title">Wheel Randomizer Tool</h2>

        <p class="card-desc">
          A customizable spinning wheel interface featuring slice editing, slice creation,
          and a dynamic winner reveal screen. Built as a lightweight browser-based utility.
        </p>

        <div class="card-footer">
          <span class="view-link">Read Log & Launch <span class="arrow">→</span></span>
        </div>
      </div>
    </a>

  </div>
</BaseLayout>

<style>
  .lab-header {
    margin-bottom: 2.5rem;
  }

  .page-title {
    font-size: 2.5rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 0.5rem;
  }

  .page-subtitle {
    font-size: 1.1rem;
    color: var(--text-muted, #94a3b8);
    max-width: 700px;
  }

  .lab-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.75rem;
  }

  a.lab-card,
  a.lab-card:link,
  a.lab-card:visited {
    display: flex;
    flex-direction: column;
    text-decoration: none !important;
    color: inherit !important;
    height: 100%;
    overflow: hidden;
    outline: none;
  }

  .card-image-wrapper {
    position: relative;
    width: 100%;
    height: 200px;
    border-radius: 6px;
    overflow: hidden;
    margin-bottom: 1.25rem;
    border: 1px solid rgba(0, 240, 255, 0.15);
    background: #000;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .lab-card:hover .card-img {
    transform: scale(1.04);
  }

  /* Interactive Badge Matched to Tag Badge Styling */
  .interactive-badge {
    position: absolute;
    top: 10px;
    left: 10px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.25rem 0.6rem;
    font-size: 0.75rem;
    font-weight: 600;
    font-family: inherit;
    color: var(--border-neon, #00f0ff) !important;
    background: rgba(0, 240, 255, 0.12);
    border: 1px solid rgba(0, 240, 255, 0.4);
    border-radius: 4px;
    backdrop-filter: blur(6px);
    box-shadow: 0 0 10px rgba(0, 240, 255, 0.2);
    letter-spacing: 0.02em;
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    background-color: var(--border-neon, #00f0ff);
    border-radius: 50%;
    box-shadow: 0 0 6px var(--border-neon, #00f0ff);
    animation: pulse 1.8s infinite;
  }

  @keyframes pulse {
    0% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.35;
      transform: scale(0.8);
    }
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }

  .card-body {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .tag-row {
    display: flex;
    gap: 0.4rem;
    margin-bottom: 0.75rem;
  }

  .card-title {
    color: #ffffff;
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .card-desc {
    color: var(--text-muted, #94a3b8);
    font-size: 0.92rem;
    line-height: 1.5;
    margin-bottom: 1.25rem;
    flex-grow: 1;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
  }

  .view-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--border-neon, #00f0ff);
    transition: color 0.2s ease;
  }

  .view-link .arrow {
    transition: transform 0.2s ease;
  }

  .lab-card:hover .view-link {
    color: #ffffff;
  }

  .lab-card:hover .view-link .arrow {
    transform: translateX(4px);
  }
</style>