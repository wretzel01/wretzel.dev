---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About | Wretzelectronics">
  <article class="about-container">
    <header class="about-header">
      <h1 class="page-title">About Henry</h1>
      <p class="page-subtitle">Embedded Systems & Hardware Engineer</p>
    </header>

    <div class="bio-card cyber-card">
      <div class="avatar-wrapper">
        <img src="/images/me.png" alt="Henry" class="avatar-img" />
      </div>

      <div class="bio-content">
        <p>
          I’m an embedded & systems engineer based in the Bronx, NY. I build practical hardware,
          wearables, and embedded devices—focusing on rapid prototyping and functional engineering.
        </p>

        <p>
          My work spans multi-processor devices, Linux-capable systems, custom PCB design,
          firmware development, and repurposing consumer electronics.
        </p>

        <p>
          This site documents my projects, experiments, and engineering process.
        </p>
      </div>
    </div>

    <section class="skills-section cyber-card">
      <h2>Skills & Focus Areas</h2>

      <div class="skills-grid">
        <div class="skill-category">
          <h3>Hardware & Firmware</h3>
          <ul class="skill-list">
            <li>Embedded Systems Engineering</li>
            <li>Custom PCB Design & Assembly</li>
            <li>Microcontrollers (ESP32, STM32)</li>
            <li>Firmware Development (C/C++, ESP-IDF)</li>
          </ul>
        </div>

        <div class="skill-category">
          <h3>Systems & Integration</h3>
          <ul class="skill-list">
            <li>Linux-Capable Devices (Raspberry Pi)</li>
            <li>Hardware Prototyping & Wearables</li>
            <li>Multi-Processor Architectures</li>
            <li>Repurposing Consumer Electronics</li>
          </ul>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .about-container {
    max-width: 850px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .about-header {
    text-align: center;
  }

  .page-title {
    font-size: 2.5rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 0.25rem;
  }

  .page-subtitle {
    font-size: 1.1rem;
    color: var(--border-neon);
    font-weight: 500;
  }

  /* Bio Card Layout */
  .bio-card {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding: 2rem;
  }

  .avatar-wrapper {
    flex-shrink: 0;
    width: 200px;
    height: 200px;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--border-neon);
    box-shadow: 0 0 15px var(--border-glow);
    background: #000;
  }

  .avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .bio-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .bio-content p {
    color: var(--text-main);
    line-height: 1.65;
    font-size: 1.02rem;
    margin: 0;
  }

  /* Skills Section Layout */
  .skills-section h2 {
    color: #ffffff;
    font-size: 1.4rem;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid rgba(0, 240, 255, 0.15);
    padding-bottom: 0.4rem;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .skill-category h3 {
    font-size: 1.05rem;
    color: var(--border-neon);
    margin-bottom: 0.75rem;
  }

  .skill-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .skill-list li {
    position: relative;
    padding-left: 1.25rem;
    color: var(--text-main);
    font-size: 0.95rem;
  }

  .skill-list li::before {
    content: "▹";
    position: absolute;
    left: 0;
    color: var(--border-neon);
  }

  @media (max-width: 640px) {
    .bio-card {
      flex-direction: column;
      text-align: center;
      align-items: center;
    }

    .avatar-wrapper {
      width: 160px;
      height: 160px;
    }
  }
</style>