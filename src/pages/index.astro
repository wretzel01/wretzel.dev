---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Home | Wretzelectronics">
  <!-- HERO SECTION -->
  <section class="hero-section">
    <h1 class="hero-title">Henry Kunzler — Hardware & Software</h1>
    <p class="hero-subtitle">
      Embedded systems, hardware builds, wearables, and engineering experiments.
    </p>
  </section>

  <!-- BIO SECTION -->
  <section class="bio-section cyber-card">
    <div class="avatar-wrapper">
      <img src="/images/me.png" alt="Henry" class="avatar-img" />
    </div>

    <div class="bio-content">
      <p class="bio-text">
        Embedded & systems engineer building practical hardware, wearables, and rapid prototypes.
        Bronx, NY.
      </p>
      <a href="/about" class="about-link">
        About <span class="arrow">→</span>
      </a>
    </div>
  </section>

  <!-- NAVIGATION CARDS GRID -->
  <section class="sections-grid">
    <!-- PROJECTS SECTION -->
    <a href="/projects" class="section-card cyber-card">
      <div class="card-header">
        <img src="/icons/projects.svg" alt="Projects" class="section-icon" />
        <h2>Projects</h2>
      </div>
      <p>Major builds: TCPendant, AHGadget, AHGlasses, and other hardware prototypes.</p>
    </a>

    <!-- LAB SECTION -->
    <a href="/lab" class="section-card cyber-card">
      <div class="card-header">
        <img src="/icons/lab.svg" alt="Lab" class="section-icon" />
        <h2>Labs</h2>
      </div>
      <p>Experiments, one-hour builds, tests, and rapid engineering prototypes.</p>
    </a>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero-section {
    padding: 3rem 0 2rem;
    text-align: center;
  }

  .hero-title {
    font-size: 2.75rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 0.75rem;
    letter-spacing: -0.02em;
  }

  .hero-subtitle {
    font-size: 1.15rem;
    color: var(--text-muted);
    max-width: 600px;
    margin: 0 auto;
  }

  /* Bio Card */
  .bio-section {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    margin: 2.5rem auto 3.5rem;
    max-width: 650px;
  }

  .avatar-wrapper {
    width: 140px;
    height: 140px;
    flex-shrink: 0;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid rgba(0, 240, 255, 0.4);
    box-shadow: 0 0 15px rgba(0, 240, 255, 0.15);
  }

  .avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bio-content {
    max-width: 360px;
  }

  .bio-text {
    font-size: 1rem;
    color: var(--text-main);
    line-height: 1.6;
    margin-bottom: 0.75rem;
  }

  .about-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-weight: 600;
    color: var(--border-neon);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .about-link .arrow {
    transition: transform 0.2s ease;
  }

  .about-link:hover {
    color: #ffffff;
  }

  .about-link:hover .arrow {
    transform: translateX(4px);
  }

  /* Navigation Cards Grid */
  .sections-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .section-card {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .card-header h2 {
    font-size: 1.4rem;
    color: #ffffff;
    font-weight: 600;
  }

  .section-icon {
    width: 40px;
    height: 40px;
    filter: invert(0.9);
  }

  .section-card p {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  @media (max-width: 600px) {
    .bio-section {
      flex-direction: column;
      text-align: center;
    }

    .bio-content {
      text-align: center;
    }
  }
</style>