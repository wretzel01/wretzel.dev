---
export interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Wretzelectronics | Hardware & Software Showcase", 
  description = "Portfolio and technical lab notes for hardware, embedded systems, and software projects." 
} = Astro.props;

import Header from '../components/Header.astro';
import Contact from '../components/Contact.astro';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    
    <!-- Cyber Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="/base.css" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>

  <body>
    <Header />

    <main>
      <slot />
    </main>

    <Contact />
  </body>
</html>